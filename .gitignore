# Build artifacts
bin/
*.tsbuildinfo
*.exe
*.exe~
*.dll
*.so
*.dylib
web/dist/
web/public/algo_drum.wasm
web/public/wasm_exec.js

# Dependencies
node_modules/
web/node_modules/
vendor/

# Environment
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Go
/algo-drum
# `GOOS=js GOARCH=wasm go build ./cmd/wasm/` (or `./...`) with no -o writes
# a plain "wasm" binary here, named after the last path element.
/wasm
*.out
*.test

# Fitting inputs and outputs (cmd/fit-physical).
#
# reference/ holds recordings used as timbre-match targets. They are not the
# repository's to redistribute and nothing in the test suite may depend on
# them — see docs/physical-measured-fit.md.
reference/
fit-report.json
fit-report.checkpoint
fit-summary.txt
fit-progress.txt
# One set per run when several are compared side by side, e.g. fit-hertzian.*.
# Name every run's artifacts with this prefix — fit-loss-0.25.json,
# fit-seeded-2of4.json — so one rule keeps covering them. A report is derived
# from a recording the repository does not contain, so it cannot be committed
# as evidence anyway: quote its numbers in docs/ and commit the figures.
fit-*.json
fit-*.checkpoint
fit-*.log
# A checkpoint is never a source file, whatever it ends up being called.
*.checkpoint
*.wav

# Built by `go build ./cmd/fit-physical` and `./cmd/render-physical`
/fit-physical
/render-physical
