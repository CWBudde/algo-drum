*.out
*.test

# Fitting inputs and outputs (cmd/fit-physical).
#
# reference/ holds recordings used as timbre-match targets. They are not the
# repository's to redistribute and nothing in the test suite may depend on
# them — see docs/physical-measured-fit.md.
reference/
fit-report.json
fit-report.checkpoint
fit-summary.txt
fit-progress.txt
# One pair per run when several are compared side by side, e.g. fit-hertzian.*
fit-*.json
fit-*.checkpoint
fit-*.log
*.wav

# Built by `go build ./cmd/fit-physical`
/fit-physical
